APP_NAME=my-black-box-app
APP_PORT=8080

# The uid/gid both containers run as. Neither runs as root, and both write into
# bind-mounted directories, so these must match the host user that owns ./src,
# ./data and ./logs. install-claude.sh / install-opencode.sh set them from
# `id -u` and `id -g`; change them only if you know why.
APP_UID=1000
APP_GID=1000

# Session signing key — change to 32+ random bytes before use
SESSION_SECRET=change-me-to-32-random-bytes-before-use

# Public URL of the app (required for webhooks, email links, OAuth callbacks)
APP_URL=

# Controls the Secure flag on session cookies, and whether /docs is mounted.
# Set to "production" when deployed over HTTPS.
APP_ENV=local

# Cloudflare Tunnel (added by /launch)
TUNNEL_TOKEN=

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=

APP_TIMEZONE=UTC

# Log file path
LOG_PATH=/logs/app.log

# Comma-separated CIDRs whose forwarding headers are believed. Empty means the
# app is directly exposed and names every caller by its socket address.
#
# REQUIRED once anything sits in front of the app. Behind the Cloudflare tunnel
# that /launch creates, every request arrives from the tunnel container, so
# with this empty the whole deployment shares ONE rate-limit bucket — five bad
# logins lock out every user. /launch sets this to the compose network.
#
# Only list networks you control. Anything inside a trusted range can name
# itself whatever it likes.
TRUSTED_PROXIES=
