@pytest.fixture
def anon() -> Iterator[TestClient]:
    """No dependency override — a genuinely signed-out caller."""
    with open_test(SCHEMA) as db:
        yield TestClient(build_app(db))


@pytest.mark.parametrize(
    ("method", "path"),
    [
        ("GET", BASE),
        ("GET", f"{BASE}/1"),
        ("POST", BASE),
        ("PUT", f"{BASE}/1"),
        ("DELETE", f"{BASE}/1"),
    ],
)
def test_every_endpoint_requires_a_signed_in_user(
    anon: TestClient, method: str, path: str
) -> None:
    """Scaffolded CRUD includes create, update and delete, so an unguarded
    resource is world-writable. Pass -public only deliberately."""
    res = anon.request(method, path, json=payload())
    assert res.status_code == 401
    assert res.json()["code"] == "unauthorized"
{% endif %}


def create_one(client: TestClient) -> dict[str, Any]:
    res = client.post(BASE, json=payload())
    assert res.status_code == 200, res.text
    data: dict[str, Any] = res.json()["data"]
    return data


def test_create_returns_the_new_row(client: TestClient) -> None:
    item = create_one(client)
    assert item["id"] >= 1
    assert "created_at" in item


def test_list_is_enveloped_with_meta(client: TestClient) -> None:
    create_one(client)
    body = client.get(BASE).json()
    assert body["ok"] is True
    assert len(body["data"]) == 1
    assert body["meta"]["total"] == 1


def test_empty_list_is_a_list_not_null(client: TestClient) -> None:
    """A strict client decoding an array fails on null."""
    body = client.get(BASE).json()
    assert body["data"] == []
    assert body["meta"]["total"] == 0


def test_detail_returns_one_row(client: TestClient) -> None:
    item = create_one(client)
    assert client.get(f"{BASE}/{item['id']}").json()["data"]["id"] == item["id"]


def test_detail_of_a_missing_row_is_404(client: TestClient) -> None:
    res = client.get(f"{BASE}/999")
    assert res.status_code == 404
    assert res.json()["code"] == "not_found"


def test_update_changes_the_row(client: TestClient) -> None:
    item = create_one(client)
    res = client.put(f"{BASE}/{item['id']}", json=payload())
    assert res.status_code == 200
    assert res.json()["data"]["id"] == item["id"]


def test_update_of_a_missing_row_is_404(client: TestClient) -> None:
    assert client.put(f"{BASE}/999", json=payload()).status_code == 404


def test_delete_removes_the_row(client: TestClient) -> None:
    item = create_one(client)
    assert client.delete(f"{BASE}/{item['id']}").status_code == 200
    assert client.get(f"{BASE}/{item['id']}").status_code == 404


def test_delete_of_a_missing_row_is_404(client: TestClient) -> None:
    assert client.delete(f"{BASE}/999").status_code == 404


def test_a_malformed_body_is_a_field_error(client: TestClient) -> None:
    res = client.post(BASE, json={"nope": 1})
    assert res.status_code == 422
    assert res.json()["code"] == "validation_failed"


@pytest.mark.parametrize("query", ["?sort=password_hash", "?filter=password_hash:x"])
def test_an_unknown_sort_or_filter_column_is_422(client: TestClient, query: str) -> None:
    """The whitelist is the only source of column names that reach SQL."""
    assert client.get(f"{BASE}{query}").status_code == 422


def test_pagination_clamps_rather_than_rejects(client: TestClient) -> None:
    create_one(client)
    assert client.get(f"{BASE}?limit=9999").json()["meta"]["limit"] == 200
